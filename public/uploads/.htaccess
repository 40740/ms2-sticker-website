# Prevent script execution in uploads directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|pht|phar|shtml|cgi|pl|py|jsp|asp|aspx|sh)$">
    Require all denied
</FilesMatch>

# Serve SVG with correct content type (prevent inline execution)
<IfModule mod_mime.c>
    AddType image/svg+xml .svg
</IfModule>

# Prevent directory listing
Options -Indexes
